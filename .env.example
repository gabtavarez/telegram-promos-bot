TELEGRAM_BOT_TOKEN=123456789:troque-pelo-token-do-bot
CHANNEL_ID=@seu_canal
# Necessario somente quando AMAZON_ENABLED=true
# AMAZON_TAG=seu-tag-20
# Pode ser uma query string completa, por exemplo: matt_tool=12345678&matt_word=hardware
ML_TAG=matt_tool=SEU_CODIGO
# API oficial do Mercado Livre (segredos somente no Render/.env local; nunca no Git)
# ML_CLIENT_ID=seu_client_id
# ML_CLIENT_SECRET=seu_client_secret
# Em produção o Render fornece RENDER_EXTERNAL_HOSTNAME automaticamente. Use ML_REDIRECT_URI apenas para sobrescrever.
# ML_REDIRECT_URI=https://telegram-promos-bot.onrender.com/oauth/mercadolivre/callback
# ML_API_CATEGORY_IDS=MLB1648

# Opcionais
# AMAZON_DEALS_URL=https://www.amazon.com.br/deals?node=16339926011
# ML_DEALS_URL=https://www.mercadolivre.com.br/ofertas/?cat=MLB421969&category=MLB1648
# DATA_FILE=./data/posted-deals.json
# RUN_ON_START=true
# CRON_SCHEDULE=*/5 * * * *
# RUN_NOW_TOKEN=crie-um-token-longo
# TELEGRAM_ADMIN_USER_ID=123456789
# Amazon permanece desativada por padrao devido aos bloqueios e regras do programa.
# AMAZON_ENABLED=false
# SHOPEE_ENABLED=false
# SHOPEE_APP_ID=
# SHOPEE_APP_SECRET=
# ALIEXPRESS_ENABLED=false
# ALIEXPRESS_APP_KEY=
# ALIEXPRESS_APP_SECRET=
# ALIEXPRESS_TRACKING_ID=
# KABUM_ENABLED=false
# KABUM_AWIN_ADVERTISER_ID=17729
# KABUM_AWIN_FEED_URL=
# KABUM_AWIN_FEED_LOCALE=pt_BR
# KABUM_CLICK_REF=telegram_canal
# AWIN_PUBLISHER_ID=
# AWIN_ACCESS_TOKEN=
# AWIN_COUPONS_ENABLED=true
# AWIN_ADVERTISER_IDS=
# Recomendado em producao. Obtenha ambos no console REST API do Upstash.
# UPSTASH_REDIS_REST_URL=https://seu-banco.upstash.io
# UPSTASH_REDIS_REST_TOKEN=seu-token
# PORT=10000
