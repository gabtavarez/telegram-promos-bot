TELEGRAM_BOT_TOKEN=123456789:troque-pelo-token-do-bot
CHANNEL_ID=@seu_canal
AMAZON_TAG=seu-tag-20
# Pode ser uma query string completa, por exemplo: matt_tool=12345678&matt_word=hardware
ML_TAG=matt_tool=SEU_CODIGO

# Opcionais
# AMAZON_DEALS_URL=https://www.amazon.com.br/deals?node=16339926011
# ML_DEALS_URL=https://www.mercadolivre.com.br/ofertas/?cat=MLB421969&category=MLB1648
# DATA_FILE=./data/posted-deals.json
# RUN_ON_START=true
# Amazon permanece desativada por padrao devido aos bloqueios e regras do programa.
# AMAZON_ENABLED=false
# Recomendado em producao. Obtenha ambos no console REST API do Upstash.
# UPSTASH_REDIS_REST_URL=https://seu-banco.upstash.io
# UPSTASH_REDIS_REST_TOKEN=seu-token
# PORT=10000
