# Mesmo banco Upstash usado pelo bot (REST API). Sem isto o painel abre em modo demonstracao.
UPSTASH_REDIS_REST_URL=https://seu-banco.upstash.io
UPSTASH_REDIS_REST_TOKEN=seu-token

# Senha do painel. Obrigatoria para salvar configuracoes; tambem protege o acesso as metricas.
DASHBOARD_PASSWORD=crie-uma-senha-longa

# Opcional: username do bot (sem @) usado no preview dos anuncios.
NEXT_PUBLIC_BOT_USERNAME=
